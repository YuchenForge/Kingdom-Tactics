# .env.example

# Copy this file to .env and customize for your environment
# DO NOT commit secrets to version control

---
# DATABASE (PostgreSQL)
---

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kingdom_tactics
POSTGRES_USER=kingdom_user
POSTGRES_PASSWORD=kingdom_password

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kingdom_tactics
SPRING_DATASOURCE_USERNAME=kingdom_user
SPRING_DATASOURCE_PASSWORD=kingdom_password
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# Database connection timeout (seconds)
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

---
# REDIS
---

SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Optional: Redis cluster or sentinel configuration
# SPRING_REDIS_SENTINEL_MASTER=mymaster
# SPRING_REDIS_SENTINEL_NODES=sentinel1:26379,sentinel2:26379

---
# SPRING BOOT (API)
---

SPRING_APPLICATION_NAME=kingdom-tactics-api
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_KINGDOM=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN

---
# JWT AUTHENTICATION
---

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-256-bits
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

---
# CORS (Frontend access)
---

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=3600

---
# RATE LIMITING
---

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=20

---
# WORKER (Background job processor)
---

WORKER_ENABLED=true
WORKER_ROUND_SCAN_INTERVAL_SECONDS=10
WORKER_LOCK_TIMEOUT_MINUTES=5
WORKER_MAX_RETRIES=3

---
# OBSERVABILITY
---

# Request tracing
REQUEST_ID_HEADER=X-Request-ID

# Structured logging (JSON format in production)
LOGGING_FORMAT=text
# LOGGING_FORMAT=json  # Use for production

# Health checks
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,ready,info
MANAGEMENT_HEALTH_PROBES_ENABLED=true

---
# FRONTEND (Vite)
---

VITE_APP_NAME=Kingdom Tactics
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WEBSOCKET_URL=ws://localhost:8080/ws

# Debug mode (verbose logging in browser console)
VITE_DEBUG=true

---
# OPTIONAL: Email (for invites, password reset — Phase 8)
---

MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@kingdom-tactics.com
MAIL_FROM_NAME=Kingdom Tactics

---
# OPTIONAL: OAuth providers (Phase 8)
---

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github

---
# OPTIONAL: Error tracking (Sentry, Phase 7)
---

SENTRY_ENABLED=false
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

---
# OPTIONAL: CDN (for storing replays, screenshots)
---

S3_ENABLED=false
S3_BUCKET=kingdom-tactics-replays
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

---
# DOCKER COMPOSE
---

# Version for Docker images
DOCKER_IMAGE_TAG=latest

# Network
DOCKER_NETWORK=kingdom-tactics-network

---
# PRODUCTION DEPLOYMENT (fill in for Render/Railway/Heroku)
---

# Database (use managed service)
# DATABASE_URL=postgresql://user:password@db-host:5432/kingdom_tactics

# Redis (use managed service)
# REDIS_URL=redis://redis-host:6379

# API URL
# API_URL=https://api.kingdom-tactics.com

# Frontend URL
# FRONTEND_URL=https://kingdom-tactics.com

# Environment
# NODE_ENV=production
# JAVA_ENVIRONMENT=production

---
# DEVELOPMENT-ONLY (NEVER commit secrets!)
---

# Test user credentials (for E2E tests)
TEST_USER_1_EMAIL=test_player1@example.com
TEST_USER_1_PASSWORD=test_password_123
TEST_USER_2_EMAIL=test_player2@example.com
TEST_USER_2_PASSWORD=test_password_456

# Demo game seed (for reproducible replays)
DEMO_GAME_SEED=12345

# Feature flags
FEATURE_SPECTATOR_MODE_ENABLED=false
FEATURE_TRAITS_ENABLED=false
FEATURE_MATCHMAKING_ENABLED=false
