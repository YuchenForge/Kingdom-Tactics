# Reference only. Set values in Render's environment settings, not in Git.
# API and worker:
SPRING_PROFILES_ACTIVE=prod
# Render's PostgreSQL connection URL must be converted to JDBC form.
# Keep username/password in separate settings, not embedded in this URL.
DB_URL=jdbc:postgresql://YOUR-INTERNAL-DB-HOST:5432/YOUR_DB?sslmode=require
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=SET_IN_RENDER
DB_POOL_SIZE=5
# API only:
JWT_SECRET=GENERATE_A_PRIVATE_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=https://YOUR-SITE.vercel.app
# PORT is supplied by Render; do not set SERVER_PORT to override it.
